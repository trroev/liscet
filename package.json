{
  "name": "next-payload-starter",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "boundaries": "turbo boundaries",
    "build": "dotenvx run --convention=nextjs -- turbo run build",
    "catalog:check": "node scripts/check-catalog.mjs",
    "clean": "turbo run clean",
    "clean:workspaces": "turbo run clean && bash scripts/clean-workspaces.sh",
    "coverage": "turbo run coverage",
    "predev": "[ \"$PORTLESS\" = \"0\" ] || portless proxy start",
    "dev": "dotenvx run --convention=nextjs -- turbo run dev",
    "e2e": "dotenvx run --convention=nextjs -- pnpm --filter @repo/e2e run e2e",
    "e2e:ui": "dotenvx run --convention=nextjs -- pnpm --filter @repo/e2e run e2e:ui",
    "email:preview": "pnpm --filter @repo/emails email:preview",
    "format": "pnpm exec biome format",
    "format:fix": "pnpm exec biome format --write",
    "generate:types": "turbo run generate:types",
    "lint": "pnpm exec ultracite check",
    "seed": "pnpm --filter web run seed",
    "storybook": "turbo run storybook",
    "lint:fix": "pnpm exec ultracite fix",
    "migrate": "cd apps/web && dotenvx run --convention=nextjs -- node ../../scripts/migrate-deploy.mjs",
    "preinstall": "only-allow pnpm",
    "rulesets:apply": "node scripts/apply-rulesets.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.39.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "only-allow": "^1.2.1",
    "portless": "catalog:",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "ultracite": "^7.6.2",
    "vitest": "catalog:",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,json}": "pnpm exec biome check --write --no-errors-on-unmatched"
  }
}
